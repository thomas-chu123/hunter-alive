; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="遠古獵人：崩塌神殿"
run/main_scene="res://scenes/ruins.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[input]

hunt_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
hunt_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
hunt_jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
hunt_attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":74)]
}
hunt_switch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
hunt_equip={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
hunt_soul={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
hunt_interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
